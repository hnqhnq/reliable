# Copy this file to /home/src/Reliable/.env.llm and fill only the two keys.
# Keep values quoted. The real .env.llm file is ignored by Git.
DASHSCOPE_API_KEY=''
DEEPSEEK_API_KEY=''

# OpenAI-compatible endpoints
QWEN_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
DEEPSEEK_BASE_URL='https://api.deepseek.com'

# C2BM: low-cost causal edge orientation
QWEN_MODEL='qwen3.7-flash-2026-07-15'
DEEPSEEK_MODEL='deepseek-flash'
C2BM_VOTES_PER_EDGE='10'

# BC-LLM: a stronger model proposes concepts; the cheaper model extracts them.
# Change QWEN_ITER_MODEL to qwen3.8-max-0902 only for the later quality run.
QWEN_ITER_MODEL='qwen3.8-flash'
QWEN_EXTRACTION_MODEL='qwen3.7-flash-2026-07-15'
BC_CUB_MAX_OBS='40'
BC_LLM_BATCH_SIZE='4'
BC_LLM_MAX_RETRIES='2'

# Match the non-thinking GPT-4o setup used as the reference.
QWEN_ENABLE_THINKING='false'
DEEPSEEK_ENABLE_THINKING='false'
